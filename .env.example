# Campus Compass — Environment Variables
# Copy this to .env.local and fill in your values.
# Never commit .env.local to git.

# ── Firebase (Client SDK) ─────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ── VPS Backend ───────────────────────────────────────────────────────────────
# The public HTTPS URL of your VPS backend (used by Next.js API proxy routes)
NEXT_PUBLIC_BACKEND_URL=https://your-vps-domain.com
NEXT_PUBLIC_VPS_DOMAIN=your-vps-domain.com

# ── VPS MediaMTX ──────────────────────────────────────────────────────────────
# Publisher password used by the Pi camera to push the stream.
# Must also be set in /etc/campus-compass.env on the VPS.
MEDIAMTX_PUBLISH_PASS=your-strong-publisher-password

# ── Ola Maps (Navigation) ────────────────────────────────────────────────────
# Get a free API key from https://maps.olacabs.com/
# If not set, the app falls back to OpenStreetMap automatically.
NEXT_PUBLIC_OLA_MAPS_API_KEY=your-ola-maps-api-key
