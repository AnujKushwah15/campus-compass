rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // 🔹 Helper Functions
    // =========================

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuth() && userDoc().data.role == "admin";
    }

    function isDriver() {
      return isAuth() && userDoc().data.role == "driver";
    }

    function isParent() {
      return isAuth() && userDoc().data.role == "parent";
    }

    function driverOwnsBus(busId) {
      return isDriver() && userDoc().data.assignedBusId == busId;
    }

    function isParentOf(studentId) {
      return isParent() &&
        exists(/databases/$(database)/documents/users/$(studentId)) &&
        get(/databases/$(database)/documents/users/$(studentId)).data.parentId == request.auth.uid;
    }

    function validKeys(data, allowedKeys) {
      return data.keys().hasOnly(allowedKeys);
    }

    function smallPayload() {
      return request.resource.data.size() < 10000; // ~10KB
    }

    // =========================
    // 🔹 USERS
    // =========================

    match /users/{userId} {

      allow read: if isAuth();

      allow create: if isAdmin() || (
        isAuth() 
        && request.auth.uid == userId
        && request.resource.data.role in ['student', 'parent', 'driver']
        && smallPayload()
      );

      allow update: if isAdmin() || (
        isAuth()
        && request.auth.uid == userId
        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        && smallPayload()
      ) || (
        // Allow parents to claim a student during linking
        isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentId'])
        && request.resource.data.parentId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // =========================
    // 🔹 BUSES
    // =========================

    match /buses/{busId} {

      allow read: if isAuth();

      allow write: if isAdmin()
        && validKeys(request.resource.data, ['plateNumber', 'capacity', 'status', 'driverId'])
        && smallPayload();
    }

    // =========================
    // 🔹 ROUTES
    // =========================

    match /routes/{routeId} {

      allow read: if isAuth();

      allow write: if isAdmin()
        && validKeys(request.resource.data, ['name', 'busId', 'stops'])
        && smallPayload();
    }



    // =========================
    // 🔹 TRIPS
    // =========================

    match /trips/{tripId} {

      allow read: if isAuth();

      allow create: if isAdmin()
        || (isDriver()
          && request.resource.data.driverId == request.auth.uid
          && driverOwnsBus(request.resource.data.busId)
          && validKeys(request.resource.data, [
            'driverId',
            'busId',
            'status',
            'startTime',
            'endTime',
            'attendance'
          ])
          && smallPayload()
        );

      allow update: if isAdmin()
        || (isDriver()
          && resource.data.driverId == request.auth.uid
          && driverOwnsBus(resource.data.busId)
          && smallPayload()
        );

      allow delete: if isAdmin();
    }

    // =========================
    // 🔹 ATTENDANCE
    // =========================

    match /attendance/{attendanceId} {

      allow read: if isAdmin()
        || isDriver()
        || (isParent() && isParentOf(resource.data.studentId))
        || (isAuth() && resource.data.studentId == request.auth.uid);

      allow create, update: if isAdmin()
        || (isDriver()
          && driverOwnsBus(resource.data.busId)
          && validKeys(request.resource.data, [
            'tripId',
            'studentId',
            'status',
            'date',
            'autoMarked',
            'busId'
          ])
          && smallPayload()
        );

      allow delete: if isAdmin();
    }

    // =========================
    // 🔹 BUS REQUESTS
    // =========================

    match /busRequests/{requestId} {

      // Students can read their own request (requestId == studentId)
      // Admins can read all requests
      allow read: if isAdmin()
        || (isAuth() && request.auth.uid == requestId);

      // Students can create/overwrite their own request only
      // requestId must equal their UID to enforce one-request-per-student
      allow create: if isAuth()
        && request.auth.uid == requestId
        && request.resource.data.status == "pending"
        && smallPayload();

      // Students can update their own pending request (e.g. cancel)
      // Admins can update any request (approve/reject)
      allow update: if isAdmin()
        || (isAuth()
          && request.auth.uid == requestId
          && smallPayload()
        );

      allow delete: if isAdmin();
    }

  }
}