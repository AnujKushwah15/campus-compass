[Unit]
Description=Campus Compass Pi Sensor Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi1
WorkingDirectory=/home/pi1/campus-compass/backend/pi
ExecStart=/home/pi1/campus-compass/backend/pi/venv/bin/python3 sensor_service.py
Restart=always
RestartSec=5
StartLimitIntervalSec=0

# Environment Configuration
EnvironmentFile=/etc/campus-compass.env

[Install]
WantedBy=multi-user.target
