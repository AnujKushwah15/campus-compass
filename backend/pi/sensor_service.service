[Unit]
Description=Campus Compass Pi Sensor Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/campus-compass/pi
ExecStart=/opt/campus-compass/venv/bin/python3 sensor_service.py
Restart=always
RestartSec=5
StartLimitIntervalSec=0

# Environment Configuration
EnvironmentFile=/etc/campus-compass.env

[Install]
WantedBy=multi-user.target
