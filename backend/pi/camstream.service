[Unit]
Description=Campus Compass Camera Stream (IP Camera → ffmpeg → MediaMTX VPS)
After=network-online.target
Wants=network-online.target
# Allow unlimited restarts — network drops are expected on a bus
StartLimitIntervalSec=0

[Service]
Type=simple
# ── User is set by setup_pi.sh when installing ────────────────────────────────
User=${PI_USER}
# ──────────────────────────────────────────────────────────────────────────────
# Architecture: IP Camera (RTSP) → Pi (ffmpeg relay) → VPS (MediaMTX)
#
# The Hi-focus HC-IPC-DQA4113-0280-DLS is an IP camera connected via Ethernet.
# It does NOT appear as /dev/video* — ffmpeg reads its RTSP stream directly.
#
# All variables below are loaded from /etc/campus-compass.env:
#   CAMERA_IP       — IP camera address on LAN (find with: arp-scan -l)
#   CAMERA_USER     — IP camera web admin username
#   CAMERA_PASS     — IP camera web admin password
#   CAMERA_RTSP_PATH— Camera RTSP path (e.g. stream1)
#   STREAM_PATH     — MediaMTX path (e.g. live_bus-1)
#   VPS_IP          — VPS public IP
#   RTMP_PASS       — MediaMTX publisher password (set in VPS mediamtx.yml)
# ──────────────────────────────────────────────────────────────────────────────
ExecStart=/usr/bin/ffmpeg \
  -rtsp_transport tcp \
  -i rtsp://${CAMERA_USER}:${CAMERA_PASS}@${CAMERA_IP}:554/${CAMERA_RTSP_PATH} \
  -c:v copy -c:a copy \
  -f rtsp -rtsp_transport tcp \
  rtsp://pi:${RTMP_PASS}@${VPS_IP}:8554/${STREAM_PATH}

# ── Quality notes ─────────────────────────────────────────────────────────────
# STREAM COPY (above) is the recommended mode for IP cameras:
#   • Zero quality loss — original camera H.264 is relayed unchanged
#   • Near-zero CPU usage on the Pi
#   • Latency is minimal (no encode delay)
#
# If the camera uses an incompatible codec OR WebRTC has issues,
# switch to re-encode by replacing ExecStart above:
#
# ExecStart=/usr/bin/ffmpeg \
#   -rtsp_transport tcp \
#   -i rtsp://${CAMERA_USER}:${CAMERA_PASS}@${CAMERA_IP}:554/${CAMERA_RTSP_PATH} \
#   -c:v libx264 -preset veryfast -tune zerolatency \
#   -crf 22 -vf scale=1920:1080 \
#   -b:v 2500k -maxrate 3000k -bufsize 5000k \
#   -f rtsp -rtsp_transport tcp \
#   rtsp://pi:${RTMP_PASS}@${VPS_IP}:8554/${STREAM_PATH}

# Auto-restart on crash (covers ffmpeg exits and network drops)
Restart=always
RestartSec=5

# ── Environment Configuration ─────────────────────────────────────────────────
EnvironmentFile=/etc/campus-compass.env

[Install]
WantedBy=multi-user.target
