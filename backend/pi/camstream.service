[Unit]
Description=Campus Compass Camera Stream (IP Camera → ffmpeg → MediaMTX VPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi1
# ──────────────────────────────────────────────────────────────────────────────
# Architecture: IP Camera (RTSP) → Pi (ffmpeg relay) → VPS (MediaMTX)
#
# The Hi-focus HC-IPC-DQA4113-0280-DLS is an IP camera connected via Ethernet.
# It does NOT appear as /dev/video* — ffmpeg reads its RTSP stream directly.
#
# Set CAMERA_IP to the IP camera's address on your LAN (find with: arp-scan -l)
# Set CAMERA_USER / CAMERA_PASS to the camera's web admin credentials
# Set CAMERA_RTSP_PATH to the camera's main stream path (try /stream1 or /1)
# Set STREAM_PATH to the MediaMTX path (live_bus-1, live_bus-2, etc.)
# Set VPS_IP to your VPS public IP
# ──────────────────────────────────────────────────────────────────────────────
ExecStart=/usr/bin/ffmpeg \
  -rtsp_transport tcp \
  -i rtsp://${CAMERA_USER}:${CAMERA_PASS}@${CAMERA_IP}:554/${CAMERA_RTSP_PATH} \
  -c:v copy -c:a copy \
  -f rtsp -rtsp_transport tcp \
  rtsp://pi:StrongPublishPass123@${VPS_IP}:8554/${STREAM_PATH}

# ── Quality notes ─────────────────────────────────────────────────────────────
# STREAM COPY (above) is the recommended mode for IP cameras:
#   • Zero quality loss — original camera H.264 is relayed unchanged
#   • Near-zero CPU usage on the Pi
#   • Latency is minimal (no encode delay)
#
# If the camera uses an incompatible codec OR WebRTC (port 8889) has issues,
# switch to the re-encode block below by replacing ExecStart above:
#
# ExecStart=/usr/bin/ffmpeg \
#   -rtsp_transport tcp \
#   -i rtsp://${CAMERA_USER}:${CAMERA_PASS}@${CAMERA_IP}:554/${CAMERA_RTSP_PATH} \
#   -c:v libx264 -preset veryfast -tune zerolatency \
#   -crf 22 \
#   -vf scale=1920:1080 \
#   -b:v 2500k -maxrate 3000k -bufsize 5000k \
#   -f rtsp -rtsp_transport tcp \
#   rtsp://pi:StrongPublishPass123@${VPS_IP}:8554/${STREAM_PATH}

# Auto-restart on crash (covers ffmpeg exits and network drops)
Restart=always
RestartSec=5
StartLimitIntervalSec=0

# ── Environment Configuration ───────────────────────────────────────────────────
EnvironmentFile=/etc/campus-compass.env


[Install]
WantedBy=multi-user.target
