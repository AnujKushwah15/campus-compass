[Unit]
Description=Campus Compass Backend (Arbitration + Stream Auth)
After=network.target mediamtx.service
Wants=mediamtx.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/campus-compass-backend
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=STREAM_JWT_SECRET=YOUR_STRONG_SECRET_HERE
Environment=VPS_IP=72.61.250.73
Environment=MEDIAMTX_API=http://localhost:9997

[Install]
WantedBy=multi-user.target
